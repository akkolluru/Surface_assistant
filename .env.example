# Home Assistant connection
HA_URL=http://127.0.0.1:8123
HA_TOKEN=replace_with_long_lived_access_token

# Daemon server (strictly localhost)
DAEMON_HOST=127.0.0.1
DAEMON_PORT=8000
HARDWARE_BACKEND=auto

# Weather (Hyderabad default)
WEATHER_LAT=17.3850
WEATHER_LON=78.4867
WEATHER_TIMEZONE=Asia/Kolkata

# Local media & launcher overrides
WALLPAPERS_DIR=~/wallpapers
ANIME_PORTAL_URL=https://example.com
