{
  "layer": "overlay",
  "position": "bottom",
  "exclusive": false,
  "passthrough": false,
  "margin-bottom": 20,
  "margin-right": 20,
  "modules-right": ["custom/home"],
  "custom/home": {
    "exec": "~/.local/share/surface-assistant/scripts/waybar-home-state.sh",
    "return-type": "json",
    "on-click": "~/.local/share/surface-assistant/scripts/return-home.sh"
  }
}
