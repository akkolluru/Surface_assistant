{
  "layer": "overlay",
  "position": "top",
  "exclusive": false,
  "passthrough": false,
  "margin-top": 12,
  "margin-right": 14,
  "modules-right": ["custom/home"],
  "custom/home": {
    "exec": "~/.local/share/surface-assistant/scripts/waybar-home-state.sh",
    "return-type": "json",
    "on-click-release": "~/.local/share/surface-assistant/scripts/return-home.sh"
  }
}
